{
  "name": "@coaspe/sap-abap-mcp",
  "version": "1.3.1",
  "description": "Headless MCP server for SAP ABAP Development Tools",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sap",
    "abap",
    "adt",
    "mcp-server",
    "abap-cloud",
    "sap-btp",
    "s4hana",
    "ecc",
    "claude",
    "codex",
    "developer-tools"
  ],
  "homepage": "https://github.com/Coaspe/sap-abap-mcp#readme",
  "bugs": {
    "url": "https://github.com/Coaspe/sap-abap-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coaspe/sap-abap-mcp.git"
  },
  "license": "MIT",
  "mcpName": "io.github.Coaspe/sap-abap-mcp",
  "type": "module",
  "main": "dist/src/library.js",
  "types": "dist/src/library.d.ts",
  "bin": {
    "sap-abap-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "SERVICES.md",
    "PRIVACY.md",
    "TERMS.md",
    "LICENSE",
    "server.json",
    "spec",
    "llms-install.md",
    "scripts/benchmark-mcp-surface.mjs",
    "scripts/check-profile-conformance.mjs",
    "scripts/live-evidence-tmp.mjs",
    "scripts/smoke-v1-stdio.mjs",
    "assets"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:mcpb": "bash scripts/build-mcpb.sh",
    "publish:smithery": "bash scripts/publish-smithery.sh",
    "benchmark:surface": "node scripts/benchmark-mcp-surface.mjs",
    "smoke:v1": "npm run build && node scripts/smoke-v1-stdio.mjs",
    "contract:v0:update": "npm run build && node scripts/update-v0-contract.mjs",
    "sync:mcpb-tools": "npm run build && node scripts/sync-mcpb-tools.mjs --write",
    "sync:lobehub": "npm run build && node scripts/sync-lobehub-manifest.mjs --write",
    "render:demo": "node scripts/render-demo.mjs",
    "evidence:live": "npm run build && node scripts/live-evidence-tmp.mjs",
    "conformance:v1": "npm run build && node scripts/check-profile-conformance.mjs",
    "conformance:v1:json": "node scripts/check-profile-conformance.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/index.js",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "abap-adt-api": "8.4.1",
    "diff": "9.0.0",
    "docx": "9.5.1",
    "dompurify": "3.4.13",
    "fflate": "0.8.3",
    "mermaid": "11.16.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
